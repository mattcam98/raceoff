# Copy to .env and adjust. Compose reads .env automatically. Everything is optional.

# Port published on the Docker host.
RACEOFF_PORT=3300

# The address phones should open, shown in the lobby and in its QR code, e.g. https://race.example.com.
# Empty: the address the TV was opened with (or this machine's network address when the TV is on localhost).
PUBLIC_URL=

# Reverse proxies in front of the app: 0 if exposed directly, 1 behind one (Nginx Proxy Manager, Caddy...).
TRUST_PROXY=0

TZ=Europe/Malta
